# Public repository: everything is ignored except the paths allowed below.
/*
!/.gitignore
!/README.md
!/instrument_data.py
!/instrument_v3.py
!/instrument-v3.md
!/instrument-v3.json
!/build-form-v3-ar.gs
!/paper/
!/analysis/
!/app/
!/.github/
!/docker-compose.prod.yml

# Never published: individual responses, internal notes, local outputs
/analysis/data/
/analysis/.mlcache/
/analysis/ANALYSIS-DECISIONS-internal.md
/analysis/spss/OUTPUT.doc
/analysis/spss/*.spv
/paper/archive/
# written by paper/publish.py when the site is built
/app/web/research/

# Build files
__pycache__/
*.pyc
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.log
/paper/*.out
/paper/*.xdv
/paper/*.synctex.gz
/paper/pg-*.png
